<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117">

    <!-- Top bar: title + language button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#161B22"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Scamsung SSU Checker"
            android:textColor="#58A6FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="monospace"/>

        <!-- Language toggle button: amber, globe icon + current lang label -->
        <LinearLayout
            android:id="@+id/btn_lang"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/lang_btn_bg"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_language"
                android:scaleType="fitCenter"
                android:layout_marginEnd="5dp"
                android:contentDescription="Language"/>

            <TextView
                android:id="@+id/tv_lang_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EN"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:text="v1.7 by Littlenine Ennea"
                android:textColor="#8B949E"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <!-- Button row: CHECK | Guide | GitHub -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <Button
                    android:id="@+id/btn_check"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_check"
                    android:textColor="#0D1117"
                    android:backgroundTint="#58A6FF"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />

                <!-- Guide button -->
                <LinearLayout
                    android:id="@+id/btn_guide"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/github_btn_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="?"
                        android:textColor="#58A6FF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_guide"
                        android:textColor="#C9D1D9"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- GitHub button -->
                <LinearLayout
                    android:id="@+id/btn_github"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/github_btn_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_github"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="GitHub" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_github"
                        android:textColor="#C9D1D9"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <!-- Results -->
            <LinearLayout
                android:id="@+id/result_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- DEVICE INFO -->
                <TextView
                    android:id="@+id/tv_section_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_device"
                    android:textColor="#0D1117"
                    android:background="#58A6FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <TextView android:id="@+id/tv_model"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_soc"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_hardware"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_carrier"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <!-- SSU -->
                <TextView
                    android:id="@+id/tv_section_ssu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_ssu"
                    android:textColor="#0D1117"
                    android:background="#3FB950"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="12dp"/>

                <TextView
                    android:id="@+id/tv_ssu_big"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:gravity="center"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:background="@drawable/card_bg"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="12dp">

                    <TextView android:id="@+id/tv_ssu_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_ssu_support"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_ssu_count"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_ssu_error"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <!-- KNOX -->
                <TextView
                    android:id="@+id/tv_section_knox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_knox"
                    android:textColor="#0D1117"
                    android:background="#D29922"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:paddingStart="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="20dp">

                    <TextView android:id="@+id/tv_knox_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_kg_state"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace" android:layout_marginBottom="4dp"/>
                    <TextView android:id="@+id/tv_keystore"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="#C9D1D9" android:textSize="12sp"
                        android:fontFamily="monospace"/>
                </LinearLayout>

                <!-- Raw props checkbox -->
                <CheckBox
                    android:id="@+id/cb_raw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_raw"
                    android:textColor="#8B949E"
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:buttonTint="#58A6FF"
                    android:layout_marginBottom="8dp"/>

                <LinearLayout
                    android:id="@+id/raw_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="14dp"
                    android:layout_marginBottom="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_raw_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/raw_title"
                        android:textColor="#8B949E"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:layout_marginBottom="8dp"/>

                    <TextView android:id="@+id/tv_raw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#79C0FF"
                        android:textSize="11sp"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"/>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="@string/footer"
                android:textColor="#484F58"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:gravity="center" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
